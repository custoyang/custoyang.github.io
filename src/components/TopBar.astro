---
// Determine base path for links
const base = import.meta.env.BASE_URL;
---
<nav class="top-bar">
  <a class="home-btn" href={base}>
    <div class="hb-hearts">
      <div class="hb-heart"></div><div class="hb-heart"></div><div class="hb-heart"></div>
    </div>
    <span>CUSTO</span>
  </a>
  <div class="nav-links">
    <a href={base + '#home'}>HOME</a>
    <a href={base + '#powerups'}>SKILLS</a>
    <a href={base + '#diary'}>DIARY</a>
    <a href={base + '#contact'}>CONTACT</a>
  </div>
  <div class="hud-score">1UP <span id="score">000000</span></div>
</nav>

<style>
  .top-bar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    background: var(--bg);
    border-bottom: var(--pixel) solid var(--beam);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px;
  }
  .home-btn {
    display: flex; align-items: center; gap: 10px;
    font-family: inherit; font-size: 0.5rem;
    color: var(--text); text-decoration: none;
    transition: color 0.2s;
  }
  .home-btn:hover { color: var(--accent); }
  .hb-hearts { display: flex; gap: 4px; }
  .hb-heart {
    width: 10px; height: 10px; background: var(--accent);
    clip-path: polygon(50% 100%, 0% 35%, 15% 0%, 50% 20%, 85% 0%, 100% 35%);
    animation: pulse 1.5s ease-in-out infinite;
  }
  .hb-heart:nth-child(2) { animation-delay: 0.3s; }
  .hb-heart:nth-child(3) { animation-delay: 0.6s; }
  @keyframes pulse { 0%,100%{transform:scale(1)} 50%{transform:scale(1.15)} }
  .nav-links { display: flex; gap: 20px; }
  .nav-links a {
    font-family: inherit; font-size: 0.45rem;
    color: var(--dim); text-decoration: none;
    transition: color 0.25s;
  }
  .nav-links a:hover { color: var(--accent); }
  .hud-score { font-size: 0.45rem; }
  .hud-score span { color: var(--accent); }
</style>
