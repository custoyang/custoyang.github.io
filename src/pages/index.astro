          <div class="ipx"></div><div class="ipx"></div><div class="ipx ipx-l"></div><div class="ipx ipx-l"></div><div class="ipx ipx-a"></div><div class="ipx ipx-a"></div><div class="ipx ipx-c"></div><div class="ipx ipx-c"></div><div class="ipx"></div>
          <div class="ipx ipx-t"></div><div class="ipx ipx-t"></div><div class="ipx ipx-l"></div><div class="ipx ipx-l"></div><div class="ipx ipx-a"></div><div class="ipx ipx-a"></div><div class="ipx ipx-c"></div><div class="ipx ipx-c"></div><div class="ipx"></div>
          <div class="ipx ipx-t"></div><div class="ipx ipx-t"></div><div class="ipx ipx-l"></div><div class="ipx ipx-l"></div><div class="ipx ipx-a"></div><div class="ipx ipx-a"></div><div class="ipx ipx-c"></div><div class="ipx ipx-c"></div><div class="ipx"></div>
          <div class="ipx ipx-d"></div><div class="ipx ipx-d"></div><div class="ipx ipx-d"></div><div class="ipx ipx-d"></div><div class="ipx ipx-d"></div><div class="ipx ipx-d"></div><div class="ipx ipx-d"></div><div class="ipx ipx-d"></div><div class="ipx ipx-d"></div>
        </div>
        <div class="powerup-name">DATA &<br>ANALYTICS</div>
        <div class="powerup-desc">Turning raw data into stories that drive decisions. ETL pipelines, dashboards, and visualizations that actually make sense.</div>
        <div class="powerup-tags">
          <span class="tag">ETL</span><span class="tag">POWER BI</span><span class="tag">TABLEAU</span><span class="tag">SQL</span><span class="tag">GRAPH QL</span>
        </div>
      </div>

      <div class="powerup-card">
        <div class="pixel-icon icon-hw">
          <div class="ipx ipx-d"></div><div class="ipx ipx-d"></div><div class="ipx ipx-d"></div><div class="ipx ipx-d"></div><div class="ipx ipx-d"></div><div class="ipx ipx-d"></div><div class="ipx ipx-d"></div><div class="ipx ipx-d"></div><div class="ipx ipx-d"></div>
          <div class="ipx ipx-d"></div><div class="ipx"></div><div class="ipx"></div><div class="ipx"></div><div class="ipx"></div><div class="ipx"></div><div class="ipx"></div><div class="ipx"></div><div class="ipx ipx-d"></div>
          <div class="ipx ipx-d"></div><div class="ipx"></div><div class="ipx"></div><div class="ipx ipx-c"></div><div class="ipx"></div><div class="ipx"></div><div class="ipx"></div><div class="ipx"></div><div class="ipx ipx-d"></div>
          <div class="ipx ipx-d"></div><div class="ipx"></div><div class="ipx ipx-c"></div><div class="ipx"></div><div class="ipx ipx-c"></div><div class="ipx"></div><div class="ipx ipx-c"></div><div class="ipx"></div><div class="ipx ipx-d"></div>
          <div class="ipx ipx-d"></div><div class="ipx"></div><div class="ipx"></div><div class="ipx"></div><div class="ipx"></div><div class="ipx ipx-c"></div><div class="ipx"></div><div class="ipx ipx-c"></div><div class="ipx ipx-d"></div>
          <div class="ipx ipx-d"></div><div class="ipx"></div><div class="ipx"></div><div class="ipx"></div><div class="ipx"></div><div class="ipx"></div><div class="ipx"></div><div class="ipx"></div><div class="ipx ipx-d"></div>
