---
import BaseLayout from '../layouts/BaseLayout.astro';
import Ladder from '../components/Ladder.astro';
import DiaryCard from '../components/DiaryCard.astro';
import { getCollection } from 'astro:content';

const allDiary = (await getCollection('diary')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---
<BaseLayout>

  <!-- ════════ HOME ════════ -->
  <section class="title-screen" id="home">
    <div class="coins-row">
      <div class="coin"></div><div class="coin"></div><div class="coin"></div><div class="coin"></div><div class="coin"></div>
    </div>

    <div class="pixel-character" aria-hidden="true">
      <div class="px"></div><div class="px"></div><div class="px"></div><div class="px px-a"></div><div class="px px-a"></div><div class="px px-a"></div><div class="px px-a"></div><div class="px px-a"></div><div class="px"></div><div class="px"></div>
      <div class="px"></div><div class="px"></div><div class="px px-a"></div><div class="px px-a"></div><div class="px px-a"></div><div class="px px-a"></div><div class="px px-a"></div><div class="px px-a"></div><div class="px px-a"></div><div class="px"></div>
      <div class="px"></div><div class="px"></div><div class="px px-d"></div><div class="px px-t"></div><div class="px px-t"></div><div class="px px-d"></div><div class="px px-t"></div><div class="px"></div><div class="px"></div><div class="px"></div>
      <div class="px"></div><div class="px px-t"></div><div class="px px-t"></div><div class="px px-t"></div><div class="px px-t"></div><div class="px px-t"></div><div class="px px-t"></div><div class="px px-t"></div><div class="px"></div><div class="px"></div>
      <div class="px"></div><div class="px px-t"></div><div class="px px-t"></div><div class="px px-t"></div><div class="px px-t"></div><div class="px px-t"></div><div class="px px-t"></div><div class="px"></div><div class="px"></div><div class="px"></div>
      <div class="px"></div><div class="px"></div><div class="px px-a"></div><div class="px px-a"></div><div class="px px-t"></div><div class="px px-a"></div><div class="px px-a"></div><div class="px px-a"></div><div class="px"></div><div class="px"></div>
      <div class="px"></div><div class="px px-a"></div><div class="px px-a"></div><div class="px px-a"></div><div class="px px-t"></div><div class="px px-a"></div><div class="px px-a"></div><div class="px px-t"></div><div class="px px-a"></div><div class="px"></div>
      <div class="px"></div><div class="px px-a"></div><div class="px px-a"></div><div class="px px-a"></div><div class="px px-t"></div><div class="px px-t"></div><div class="px px-t"></div><div class="px px-t"></div><div class="px px-a"></div><div class="px"></div>
      <div class="px"></div><div class="px"></div><div class="px px-t"></div><div class="px px-t"></div><div class="px px-t"></div><div class="px px-t"></div><div class="px px-t"></div><div class="px"></div><div class="px"></div><div class="px"></div>
      <div class="px"></div><div class="px"></div><div class="px px-d"></div><div class="px px-d"></div><div class="px"></div><div class="px"></div><div class="px px-d"></div><div class="px px-d"></div><div class="px"></div><div class="px"></div>
      <div class="px"></div><div class="px px-d"></div><div class="px px-d"></div><div class="px px-d"></div><div class="px"></div><div class="px"></div><div class="px px-d"></div><div class="px px-d"></div><div class="px px-d"></div><div class="px"></div>
      <div class="px px-d"></div><div class="px px-d"></div><div class="px px-d"></div><div class="px px-d"></div><div class="px"></div><div class="px"></div><div class="px px-d"></div><div class="px px-d"></div><div class="px px-d"></div><div class="px px-d"></div>
    </div>

    <h1>CUSTO YANG</h1>
    <p class="welcome-text">
      Hey, welcome. This is a work in progress. 
      I’m collecting thoughts, experiences, 
      and small moments over time.
    </p>
    <div class="platform"></div>
    <div class="barrel-row" aria-hidden="true">
      <div class="barrel"></div>
      <div class="barrel" style="animation-delay:-1s"></div>
      <div class="barrel" style="animation-delay:-2s"></div>
      <div class="barrel" style="animation-delay:-3s"></div>
    </div>
    <p class="blink-text">▼ SCROLL DOWN TO START ▼</p>
  </section>

  <Ladder />

  <!-- ════════ POWER-UPS ════════ -->
