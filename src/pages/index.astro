        </div>
        <div class="powerup-name">HARDWARE<br>TESTING</div>
        <div class="powerup-desc">Hands-on with RF, signal integrity, and test automation. Bridging the gap between physical hardware and data-driven validation.</div>
        <div class="powerup-tags">
          <span class="tag">KEYSIGHT</span><span class="tag">NI</span><span class="tag">MINI-CIRCUITS</span><span class="tag">RF</span><span class="tag">AUTOMATION</span>
        </div>
      </div>

    </div>
    <div class="platform" style="margin-top:30px"></div>
  </section>

  <Ladder align="right" />

  <!-- ════════ OFF THE CLOCK ════════ -->
  <section class="level reveal" id="life">
    <div class="platform"></div>
    <div class="level-label">LEVEL 2</div>
    <h2>OFF THE CLOCK</h2>
    <p style="font-size:0.45rem; line-height:2.4; color:var(--dim); margin-bottom:20px;">When I'm not staring at a terminal.</p>

    <div class="interests-row">
      <div class="interest-mini"><div class="mini-icon">🍜</div><div class="mini-label">COOKING</div></div>
      <div class="interest-mini"><div class="mini-icon">🏋</div><div class="mini-label">GYM</div></div>
      <div class="interest-mini"><div class="mini-icon">🏓</div><div class="mini-label">PICKLEBALL</div></div>
      <div class="interest-mini"><div class="mini-icon">🍱</div><div class="mini-label">FOODIE</div></div>
      <div class="interest-mini"><div class="mini-icon">🎮</div><div class="mini-label">GAMING</div></div>
      <div class="interest-mini"><div class="mini-icon">🌍</div><div class="mini-label">EXPLORING</div></div>
    </div>
    <div class="platform" style="margin-top:30px"></div>
  </section>

  <Ladder align="left" />

  <!-- ════════ DIARY ════════ -->
  <section class="level reveal" id="diary">
    <div class="platform"></div>
    <div class="level-label">LEVEL 3</div>
    <h2>DIARY</h2>

    <div class="diary-entries">
      {allDiary.map(entry => (
        <DiaryCard
          title={entry.data.title}
          date={entry.data.date}
          preview={entry.data.preview}
          tags={entry.data.tags}
          slug={entry.slug}
        />
      ))}
    </div>
    <div class="platform" style="margin-top:30px"></div>
  </section>

  <Ladder />

  <!-- ════════ CONTACT ════════ -->
  <section class="level reveal" id="contact">
    <div class="platform"></div>
    <div class="contact-section">
      <div class="coins-row" style="padding:20px 0">
        <div class="coin"></div><div class="coin"></div><div class="coin"></div>
      </div>
      <h2>CONTINUE?</h2>
      <p>Insert coin to get in touch.<br>Always down for new quests.</p>

      <div class="social-links">
