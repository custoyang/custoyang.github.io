<style>
  /* ── Title Screen ── */
  .title-screen { padding: 60px 0 40px; text-align: center; }
  .title-screen h1 {
    font-size: 1.5rem; color: var(--text);
    letter-spacing: 4px; margin-bottom: 20px;
    animation: flicker 3s infinite;
  }
  @keyframes flicker { 0%,95%,100%{opacity:1} 96%{opacity:.7} 97%{opacity:1} 98%{opacity:.6} }
  .welcome-text {
    font-size: 0.55rem; color: var(--dim);
    line-height: 2.4; max-width: 520px;
    margin: 0 auto 30px; letter-spacing: 1px;
  }

  /* ── Pixel Character ── */
  .pixel-character {
    margin: 30px auto; width: 80px; height: 96px;
    display: grid; grid-template-columns: repeat(10,8px); grid-template-rows: repeat(12,8px);
    image-rendering: pixelated;
  }
  .px { width:8px; height:8px; }
  .px-a { background: var(--accent); }
  .px-t { background: var(--text); }
  .px-d { background: var(--dim); }

  /* ── Power-ups ── */
  .powerups-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 20px; }
  .powerup-card { border: 2px solid var(--beam); padding: 22px 18px; transition: border-color 0.3s; }
  .powerup-card:hover { border-color: var(--accent); }
  .pixel-icon { display: grid; image-rendering: pixelated; margin-bottom: 14px; }
  .ipx { width:5px; height:5px; }
  .ipx-a { background: var(--accent); }
  .ipx-c { background: var(--coin); }
  .ipx-t { background: var(--text); }
  .ipx-l { background: var(--ladder); }
  .ipx-d { background: var(--dim); }
  .icon-code,.icon-data,.icon-hw { grid-template-columns: repeat(9,5px); grid-template-rows: repeat(7,5px); width:45px; height:35px; }
  .powerup-name { font-size: 0.5rem; color: var(--text); margin-bottom: 10px; letter-spacing: 1px; }
  .powerup-desc { font-size: 0.38rem; line-height: 2.2; color: var(--dim); margin-bottom: 12px; }
  .powerup-card:hover .powerup-desc { color: var(--text); }
  .powerup-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .powerup-card:hover .tag { border-color: var(--accent); color: var(--accent); }

  /* ── Interests ── */
  .interests-row { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 14px; margin-top: 20px; }
  .interest-mini { border: 2px solid var(--beam); padding: 16px; text-align: center; transition: border-color 0.3s; }
  .interest-mini:hover { border-color: var(--accent); }
  .mini-icon { font-size: 0.6rem; color: var(--coin); margin-bottom: 8px; }
  .mini-label { font-size: 0.38rem; color: var(--dim); letter-spacing: 2px; transition: color 0.3s; }
  .interest-mini:hover .mini-label { color: var(--text); }

  /* ── Diary ── */
  .diary-entries { display: flex; flex-direction: column; gap: 16px; margin-top: 20px; }

  /* ── Contact ── */
  .contact-section { text-align: center; padding: 40px 0; }
