---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('diary');
  const sorted = entries.sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );
  return sorted.map((entry, index) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      prevSlug: index < sorted.length - 1 ? sorted[index + 1].slug : null,
      nextSlug: index > 0 ? sorted[index - 1].slug : null,
    },
  }));
}

const { entry, prevSlug, nextSlug } = Astro.props;
const { Content } = await entry.render();
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${entry.data.title} — Custo Yang`}>
  <div class="diary-page">
    <a class="diary-back" href={base + '#diary'}>◄ BACK TO DIARY</a>
    <div class="platform"></div>

    <div class="dp-date">{entry.data.date}</div>
    <h1 class="dp-title">{entry.data.title}</h1>
    <div class="dp-separator"></div>

    <div class="dp-body">
      <Content />
    </div>

    <div class="dp-tags">
      {entry.data.tags.map(t => <span class="tag">{t}</span>)}
    </div>

    <div class="dp-nav">
      {prevSlug ? (
        <a class="dp-nav-btn" href={`${base}diary/${prevSlug}/`}>◄ PREV</a>
      ) : (
        <span class="dp-nav-btn disabled">◄ PREV</span>
      )}
      {nextSlug ? (
        <a class="dp-nav-btn" href={`${base}diary/${nextSlug}/`}>NEXT ►</a>
      ) : (
        <span class="dp-nav-btn disabled">NEXT ►</span>
      )}
    </div>

    <div class="platform" style="margin-top:30px"></div>
  </div>
</BaseLayout>

<style>
  .diary-page {
    max-width: 700px;
    margin: 0 auto;
    padding: 20px 0 60px;
  }

  .diary-back {
    font-family: inherit; font-size: 0.4rem;
    color: var(--accent); margin-bottom: 30px;
    display: inline-flex; align-items: center; gap: 8px;
    transition: color 0.2s;
    text-decoration: none;
  }
  .diary-back:hover { color: var(--coin); }

  .dp-date {
    font-size: 0.35rem; color: var(--accent);
    letter-spacing: 2px; margin-bottom: 12px;
  }

  .dp-title {
    font-size: 0.75rem; color: var(--text);
    letter-spacing: 2px; margin-bottom: 24px; line-height: 1.8;
  }

  .dp-separator {
    width: 60px; height: 3px;
    background: var(--accent);
    margin: 0 0 30px;
  }

  .dp-body {
    font-size: 0.42rem; line-height: 2.6; color: var(--dim);
  }
  .dp-body :global(p) { margin-bottom: 20px; }

  .dp-tags {
    margin-top: 30px; display: flex; gap: 8px; flex-wrap: wrap;
  }
  .dp-tags .tag { border-color: var(--accent); color: var(--accent); }

  .dp-nav {
    margin-top: 40px; display: flex; justify-content: space-between;
  }

  .dp-nav-btn {
    font-family: inherit; font-size: 0.35rem;
    color: var(--dim); padding: 10px 16px;
    border: 2px solid var(--beam);
    transition: all 0.3s; text-decoration: none;
  }
  .dp-nav-btn:hover { border-color: var(--accent); color: var(--accent); }
  .dp-nav-btn.disabled { opacity: 0.3; pointer-events: none; }
</style>
